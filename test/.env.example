# Copy this file to test/.env (or the repo-root .env) and fill in real values.
# Names match GitHub Actions repo secrets. GitHub will not export those values
# via `gh secret`; paste them from the repo Settings → Secrets → Actions page.

# secrets.GOOGLE_API_KEY — Gemini narration in ai_weather_briefing.py
GOOGLE_API_KEY=

# secrets.CDSAPI_KEY — ECMWF Data Stores / analog-years (also mapped to ECMWF_DATASTORES_KEY)
CDSAPI_KEY=

# secrets.TAHMO_API_USERNAME / secrets.TAHMO_API_PASSWORD — station obs
TAHMO_API_USERNAME=
TAHMO_API_PASSWORD=

# secrets.EARTHDATA_USERNAME / secrets.EARTHDATA_PASSWORD
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# secrets.RESEND_API_KEY — briefing email SMTP
RESEND_API_KEY=

# secrets.RCLONE_CONFIG — base64(rclone.conf) or a local rclone.conf path
RCLONE_CONFIG=
