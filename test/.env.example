# Copy this file to test/.env and fill in real values.
# test/.env is gitignored (everything under test/ is), so secrets never get committed.

# Needed by ai_weather_briefing.py (Gemini call)
GOOGLE_API_KEY=

# Needed by plot_s2s_04deg_.py to download a 0.4 degree forecast that isn't already in
# test/run/private_data/forecast_04deg/<date>/ (address of the forecast folder on CHC's server)
FORECAST_04DEG_URL=
